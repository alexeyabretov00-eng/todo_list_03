{
  "name": "todo-list-backend",
  "version": "1.0.0",
  "description": "Backend REST API for hierarchical todo management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate": "ts-node src/db/migrate.ts"
  },
  "keywords": ["todo", "rest-api", "typescript", "express", "sqlite"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "5.2.1",
    "dotenv": "17.3.1",
    "sql.js": "1.14.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "25.2.3",
    "@types/express": "5.0.6",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "jest": "30.2.0",
    "@types/jest": "30.0.0",
    "ts-jest": "29.4.6",
    "supertest": "7.2.2",
    "@types/supertest": "6.0.3"
  },
  "overrides": {
    "glob": "13.0.3",
    "rimraf": "6.1.3"
  }
}
