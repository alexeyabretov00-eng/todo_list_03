{
  "name": "todo-list-backend",
  "version": "1.0.0",
  "description": "Backend REST API for hierarchical todo management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc && (if not exist dist\\db\\migrations mkdir dist\\db\\migrations) && xcopy /Y src\\db\\migrations\\*.sql dist\\db\\migrations\\",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate": "ts-node src/db/migrate.ts"
  },
  "keywords": [
    "todo",
    "rest-api",
    "typescript",
    "express",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/sql.js": "1.4.9",
    "@types/uuid": "10.0.0",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "sql.js": "1.14.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.2.3",
    "@types/supertest": "6.0.3",
    "jest": "30.2.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "glob": "13.0.3",
    "rimraf": "6.1.3"
  }
}
